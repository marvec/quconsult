---
// /ai-readiness — Phase 4 §3.11 lead magnet.
// Stitch winner c5274781 (decisions.md §8).
//
// Multi-step formulář (5 kroků) s vanilla JS navigací. Submit posílá JSON
// na ${PUBLIC_API_BASE_URL}/api/ai-readiness (Vercel funkce s reCAPTCHA v3
// verifikací a SMTP odesláním text shrnutí). Bez JS form spadne na mailto:
// jako graceful degradation. PDF generování + scoring algorithm = Phase 6+
// (plan §3.11 — "pro fázi launch stačí placeholder + textové shrnutí").

import BaseLayout from '../layouts/BaseLayout.astro';

const stepTitles = [
  'O firmě',
  'Datová připravenost',
  'Lidé a procesy',
  'Cíle',
  'Kontakt',
];

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL;
---
<BaseLayout
  title="AI Readiness Assessment — QuConsult"
  description="Zjistěte AI zralost vaší firmy za 10 minut. Krátký dotazník o procesech, datech a cílech. Do 24 hodin pošleme zprávu s konkrétními doporučeními. Bez prodejního volání."
>
  <section class="container-quc py-xxl">
    <div class="grid gap-xl lg:grid-cols-[2fr_1fr] lg:items-start">
      <!-- Form (hlavní sloupec) -->
      <div>
        <header class="max-w-3xl">
          <p class="text-label uppercase tracking-wider text-amber">AI Readiness Assessment</p>
          <h1 class="mt-md font-serif text-h1-mobile leading-[1.1] tracking-tight md:text-5xl">
            Zjistěte AI zralost vaší firmy za <span class="italic text-amber">10 minut</span>
          </h1>
          <p class="mt-lg text-body-lg text-ink-muted">
            Krátký dotazník o vašich procesech, datech, lidech a cílech. Do
            24 hodin odpovíme krátkou zprávou s orientačním skóre a konkrétním
            doporučením, kde u vás dává AI smysl jako první.
          </p>
          <p class="mt-md text-body text-ink-muted">
            Žádné prodejní volání. Žádné tlaky. Pokud z odpovědí vyjde, že AI
            ještě nemá smysl, řekneme to.
          </p>
        </header>

        <!-- Progress bar -->
        <div class="mt-xl" id="progress-wrapper">
          <div class="flex items-end justify-between text-label">
            <span class="font-medium text-amber" id="progress-label">Krok 1 z 5</span>
            <span class="text-ink-muted" id="progress-step-name">{stepTitles[0]}</span>
          </div>
          <div class="mt-sm flex h-1 gap-xs" role="progressbar" aria-valuemin="1" aria-valuemax="5" aria-valuenow="1" id="progress-bar">
            {[1, 2, 3, 4, 5].map((i) => (
              <div
                data-step-indicator={i}
                class:list={[
                  'h-full flex-1',
                  i === 1 ? 'bg-amber' : 'bg-border',
                ]}
              />
            ))}
          </div>
        </div>

        <form
          id="readiness-form"
          method="post"
          action="mailto:hello@quconsult.cz"
          enctype="text/plain"
          class="mt-xl space-y-xl"
          novalidate
        >
          <!-- STEP 1 — O firmě -->
          <fieldset data-step="1" class="space-y-xl">
            <legend class="sr-only">O firmě</legend>

            <div>
              <p class="text-label uppercase tracking-wider text-ink-soft">Velikost firmy *</p>
              <div class="mt-md grid grid-cols-2 gap-sm md:grid-cols-5">
                {['pod 30', '30–50', '50–150', '150–300', '300+'].map((opt) => (
                  <label class="cursor-pointer rounded border border-border bg-bg p-md text-center transition-colors has-[:checked]:border-amber has-[:checked]:bg-amber/5 hover:border-amber">
                    <input type="radio" name="velikost" value={opt} required class="sr-only" />
                    <span class="text-body text-ink">{opt}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="grid gap-xl md:grid-cols-2">
              <label>
                <span class="block text-label uppercase tracking-wider text-ink-soft">Obor *</span>
                <select name="obor" required class="mt-sm w-full appearance-none border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink focus:border-amber focus:outline-none focus:ring-0">
                  <option value="">Vyberte obor</option>
                  <option>Výroba</option>
                  <option>Profesionální služby</option>
                  <option>Obchod a velkoobchod</option>
                  <option>Stavebnictví</option>
                  <option>IT a software</option>
                  <option>Jiné</option>
                </select>
              </label>

              <label>
                <span class="block text-label uppercase tracking-wider text-ink-soft">Hlavní ERP *</span>
                <select name="erp" required class="mt-sm w-full appearance-none border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink focus:border-amber focus:outline-none focus:ring-0">
                  <option value="">Vyberte systém</option>
                  <option>Pohoda</option>
                  <option>Helios</option>
                  <option>SAP Business One</option>
                  <option>MS Dynamics</option>
                  <option>Money S3</option>
                  <option>Vlastní řešení</option>
                  <option>Jiné</option>
                  <option>Žádný ERP</option>
                </select>
              </label>
            </div>

            <label class="block">
              <span class="block text-label uppercase tracking-wider text-ink-soft">Co děláte v jedné větě?</span>
              <input
                type="text"
                name="cinnost"
                placeholder="Např. vyrábíme precizní díly pro automotive."
                class="mt-sm w-full border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink placeholder:text-ink-soft focus:border-amber focus:outline-none focus:ring-0"
              />
            </label>
          </fieldset>

          <!-- STEP 2 — Datová připravenost -->
          <fieldset data-step="2" class="hidden space-y-xl">
            <legend class="sr-only">Datová připravenost</legend>

            <div>
              <p class="text-label uppercase tracking-wider text-ink-soft">Kde žijí vaše firemní data? * (více možností)</p>
              <div class="mt-md grid gap-sm md:grid-cols-2">
                {['V ERP systému', 'V Excelu / Google Sheets', 'V cloudu (SharePoint, Drive)', 'Ve vlastní databázi', 'Papírově nebo částečně papírově', 'V e-mailových schránkách'].map((opt) => (
                  <label class="flex cursor-pointer items-center gap-md rounded border border-border bg-bg p-md transition-colors has-[:checked]:border-amber has-[:checked]:bg-amber/5 hover:border-amber">
                    <input type="checkbox" name="data-kde" value={opt} class="h-4 w-4 accent-amber" />
                    <span class="text-body text-ink">{opt}</span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <p class="text-label uppercase tracking-wider text-ink-soft">Jak hodnotíte kvalitu firemních dat? *</p>
              <div class="mt-md grid gap-sm md:grid-cols-2 lg:grid-cols-4">
                {['Vynikající', 'Použitelná', 'Roztříštěná', 'Nevíme'].map((opt) => (
                  <label class="cursor-pointer rounded border border-border bg-bg p-md text-center transition-colors has-[:checked]:border-amber has-[:checked]:bg-amber/5 hover:border-amber">
                    <input type="radio" name="data-kvalita" value={opt} required class="sr-only" />
                    <span class="text-body text-ink">{opt}</span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <p class="text-label uppercase tracking-wider text-ink-soft">Máte interní reporting / BI?</p>
              <div class="mt-md grid gap-sm md:grid-cols-3">
                {['Ano, funkční', 'Částečně', 'Ne'].map((opt) => (
                  <label class="cursor-pointer rounded border border-border bg-bg p-md text-center transition-colors has-[:checked]:border-amber has-[:checked]:bg-amber/5 hover:border-amber">
                    <input type="radio" name="reporting" value={opt} class="sr-only" />
                    <span class="text-body text-ink">{opt}</span>
                  </label>
                ))}
              </div>
            </div>
          </fieldset>

          <!-- STEP 3 — Lidé a procesy -->
          <fieldset data-step="3" class="hidden space-y-xl">
            <legend class="sr-only">Lidé a procesy</legend>

            <div>
              <p class="text-label uppercase tracking-wider text-ink-soft">Kdo by AI projekt vedl? *</p>
              <div class="mt-md grid gap-sm md:grid-cols-3">
                {['CEO / vedení', 'IT manažer / CTO', 'COO / provoz', 'Externí partner', 'Zatím nikdo'].map((opt) => (
                  <label class="cursor-pointer rounded border border-border bg-bg p-md text-center transition-colors has-[:checked]:border-amber has-[:checked]:bg-amber/5 hover:border-amber">
                    <input type="radio" name="vedeni" value={opt} required class="sr-only" />
                    <span class="text-body text-ink">{opt}</span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <p class="text-label uppercase tracking-wider text-ink-soft">Jak vidíte postoj týmu k AI? *</p>
              <div class="mt-md grid gap-sm md:grid-cols-2 lg:grid-cols-4">
                {['Velký zájem', 'Spíše opatrné', 'Skeptické', 'Otevřený odpor'].map((opt) => (
                  <label class="cursor-pointer rounded border border-border bg-bg p-md text-center transition-colors has-[:checked]:border-amber has-[:checked]:bg-amber/5 hover:border-amber">
                    <input type="radio" name="tym-postoj" value={opt} required class="sr-only" />
                    <span class="text-body text-ink">{opt}</span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <p class="text-label uppercase tracking-wider text-ink-soft">Kolik hodin týdně by tým mohl AI projektu věnovat?</p>
              <div class="mt-md grid gap-sm md:grid-cols-2 lg:grid-cols-4">
                {['2–4 h', '5–10 h', '10–20 h', 'Více'].map((opt) => (
                  <label class="cursor-pointer rounded border border-border bg-bg p-md text-center transition-colors has-[:checked]:border-amber has-[:checked]:bg-amber/5 hover:border-amber">
                    <input type="radio" name="kapacita" value={opt} class="sr-only" />
                    <span class="text-body text-ink">{opt}</span>
                  </label>
                ))}
              </div>
            </div>
          </fieldset>

          <!-- STEP 4 — Cíle -->
          <fieldset data-step="4" class="hidden space-y-xl">
            <legend class="sr-only">Cíle</legend>

            <div>
              <p class="text-label uppercase tracking-wider text-ink-soft">Hlavní cíl projektu *</p>
              <div class="mt-md grid gap-sm md:grid-cols-2 lg:grid-cols-3">
                {['Úspora času', 'Nové produkty', 'Vyšší kvalita', 'Zákaznická zkušenost', 'Compliance / GDPR', 'Něco jiného'].map((opt) => (
                  <label class="cursor-pointer rounded border border-border bg-bg p-md text-center transition-colors has-[:checked]:border-amber has-[:checked]:bg-amber/5 hover:border-amber">
                    <input type="radio" name="cil" value={opt} required class="sr-only" />
                    <span class="text-body text-ink">{opt}</span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <p class="text-label uppercase tracking-wider text-ink-soft">Realistický horizont prvního výsledku *</p>
              <div class="mt-md grid gap-sm md:grid-cols-2 lg:grid-cols-4">
                {['Do 3 měsíců', 'Do 6 měsíců', 'Do roka', 'Déle'].map((opt) => (
                  <label class="cursor-pointer rounded border border-border bg-bg p-md text-center transition-colors has-[:checked]:border-amber has-[:checked]:bg-amber/5 hover:border-amber">
                    <input type="radio" name="horizont" value={opt} required class="sr-only" />
                    <span class="text-body text-ink">{opt}</span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <p class="text-label uppercase tracking-wider text-ink-soft">Orientační rozpočet pro pilot</p>
              <div class="mt-md grid gap-sm md:grid-cols-2 lg:grid-cols-5">
                {['Pod 100 tis. Kč', '100–300 tis.', '300–500 tis.', 'Nad 500 tis.', 'Nevíme'].map((opt) => (
                  <label class="cursor-pointer rounded border border-border bg-bg p-md text-center transition-colors has-[:checked]:border-amber has-[:checked]:bg-amber/5 hover:border-amber">
                    <input type="radio" name="rozpocet" value={opt} class="sr-only" />
                    <span class="text-body text-ink">{opt}</span>
                  </label>
                ))}
              </div>
            </div>
          </fieldset>

          <!-- STEP 5 — Kontakt -->
          <fieldset data-step="5" class="hidden space-y-xl">
            <legend class="sr-only">Kontakt</legend>

            <p class="text-body-lg text-ink-muted">
              Posledních pár polí. E-mail je nutný — bez něj nemáme kam zprávu poslat.
            </p>

            <div class="grid gap-xl md:grid-cols-2">
              <label>
                <span class="block text-label uppercase tracking-wider text-ink-soft">Jméno a příjmení *</span>
                <input
                  type="text"
                  name="jmeno"
                  required
                  minlength="2"
                  autocomplete="name"
                  class="mt-sm w-full border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink focus:border-amber focus:outline-none focus:ring-0"
                />
              </label>
              <label>
                <span class="block text-label uppercase tracking-wider text-ink-soft">Firma *</span>
                <input
                  type="text"
                  name="firma"
                  required
                  autocomplete="organization"
                  class="mt-sm w-full border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink focus:border-amber focus:outline-none focus:ring-0"
                />
              </label>
              <label>
                <span class="block text-label uppercase tracking-wider text-ink-soft">E-mail *</span>
                <input
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="mt-sm w-full border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink focus:border-amber focus:outline-none focus:ring-0"
                />
              </label>
              <label>
                <span class="block text-label uppercase tracking-wider text-ink-soft">Telefon (volitelné)</span>
                <input
                  type="tel"
                  name="telefon"
                  autocomplete="tel"
                  class="mt-sm w-full border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink focus:border-amber focus:outline-none focus:ring-0"
                />
              </label>
            </div>

            <div class="flex items-start gap-md">
              <input
                id="readiness-gdpr"
                name="gdpr"
                type="checkbox"
                required
                value="souhlasím"
                class="mt-1 h-4 w-4 cursor-pointer accent-amber"
              />
              <label for="readiness-gdpr" class="cursor-pointer text-label text-ink-muted">
                Souhlasím se zpracováním osobních údajů dle
                <a href="/soukromi" class="text-amber underline underline-offset-2">zásad ochrany soukromí</a>.
              </label>
            </div>
          </fieldset>

          <!-- Error box (skrytý do submitu) -->
          <div
            id="readiness-error"
            class="hidden rounded border border-red-300 bg-red-50 p-md text-label text-red-700"
            role="alert"
          ></div>

          <!-- Navigation -->
          <div class="flex flex-wrap items-center justify-between gap-md border-t border-border pt-xl">
            <button
              type="button"
              id="btn-prev"
              class="rounded border border-border px-lg py-md text-label font-medium uppercase tracking-wider text-ink-muted transition-colors hover:border-ink hover:text-ink disabled:cursor-not-allowed disabled:opacity-30"
              disabled
            >
              Zpět
            </button>
            <button
              type="button"
              id="btn-next"
              class="rounded bg-amber px-lg py-md text-label font-medium uppercase tracking-wider text-bg transition-colors hover:bg-amber-deep"
            >
              Pokračovat
            </button>
            <button
              type="submit"
              id="btn-submit"
              class="hidden rounded bg-amber px-lg py-md text-label font-medium uppercase tracking-wider text-bg transition-colors hover:bg-amber-deep disabled:cursor-not-allowed disabled:opacity-60"
            >
              Odeslat dotazník
            </button>
          </div>

          <p class="text-label italic text-ink-soft">
            Otázky odhalují bolesti, ne mezery. Žádná otázka kromě označených * není
            povinná — odpovězte jen na to, co vám dává smysl.
          </p>

          <p class="text-label text-ink-soft">
            Formulář je chráněn proti spamu přes Google reCAPTCHA — odesláním
            souhlasíte s
            <a href="https://policies.google.com/privacy" rel="noopener" class="text-amber underline underline-offset-2">privacy policy</a>
            a
            <a href="https://policies.google.com/terms" rel="noopener" class="text-amber underline underline-offset-2">terms of service</a>
            Googlu.
          </p>
        </form>

        <!-- Success state (skrytý do submitu) -->
        <div id="success-state" class="hidden mt-xl space-y-xl">

          <!-- Hero score block -->
          <div class="rounded border border-amber bg-amber/5 p-xl md:p-xxl">
            <p class="text-label uppercase tracking-wider text-amber">Vaše orientační skóre</p>
            <div class="mt-md flex items-baseline gap-md">
              <span class="font-serif text-7xl text-ink leading-none" id="score-total">—</span>
              <span class="font-serif text-2xl text-ink-muted">/ 100</span>
            </div>
            <p class="mt-md text-body-lg text-ink" id="score-summary"></p>
          </div>

          <!-- 4 dimenze -->
          <div class="rounded border border-border bg-bg-warm/40 p-xl">
            <p class="text-label uppercase tracking-wider text-amber">4 dimenze</p>
            <ul class="mt-lg space-y-lg">
              {[
                { key: 'data', label: 'Data' },
                { key: 'lide', label: 'Lidé' },
                { key: 'strategie', label: 'Strategie' },
                { key: 'provoz', label: 'Provoz' },
              ].map((d) => (
                <li>
                  <div class="flex items-baseline justify-between">
                    <span class="text-body text-ink">{d.label}</span>
                    <span class="font-serif text-body text-ink" data-dim-score={d.key}>—</span>
                  </div>
                  <div class="mt-xs h-2 rounded-sm bg-border overflow-hidden">
                    <div
                      class="h-full bg-amber transition-[width] duration-700 ease-out"
                      data-dim-bar={d.key}
                      style="width: 0%"
                    />
                  </div>
                  <p class="mt-xs text-label text-ink-muted" data-dim-note={d.key}></p>
                </li>
              ))}
            </ul>
          </div>

          <!-- Status update -->
          <div class="rounded border border-border bg-bg p-xl">
            <p class="text-label uppercase tracking-wider text-amber">Co se děje teď</p>
            <ul class="mt-md space-y-md text-body text-ink-muted">
              <li>
                <span class="text-ink">→</span>
                Detailní 4stránkový PDF report dorazí na <strong class="text-ink" id="success-email">—</strong> do minuty.
              </li>
              <li>
                <span class="text-ink">→</span>
                Tým QuConsult se na Vaše odpovědi také podívá a do <strong class="text-ink">jednoho pracovního dne</strong> se Vám ozveme s konkrétním návazným krokem.
              </li>
              <li>
                <span class="text-ink">→</span>
                Žádné prodejní volání, žádný funnel.
              </li>
            </ul>
          </div>

          <!-- CTA -->
          <div class="flex flex-wrap gap-md">
            <a
              href="/kontakt"
              class="inline-flex items-center rounded bg-amber px-lg py-md text-label font-medium text-bg transition-colors hover:bg-amber-deep"
            >
              Domluvit 45min konzultaci rovnou
            </a>
            <a
              href="/"
              class="inline-flex items-center rounded border border-ink px-lg py-md text-label font-medium text-ink transition-colors hover:border-amber hover:text-amber"
            >
              Zpět na úvod
            </a>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-xl lg:sticky lg:top-24">
        <div class="rounded border border-border bg-bg-warm/40 p-xl">
          <p class="text-label uppercase tracking-wider text-amber">Co dostanete</p>
          <ul class="mt-md space-y-md text-body text-ink-muted">
            <li><span class="text-ink">→</span> Orientační skóre 0–100 ve 4 dimenzích.</li>
            <li><span class="text-ink">→</span> Konkrétní doporučení, kde u vás dává AI smysl jako první.</li>
            <li><span class="text-ink">→</span> Co byste měli dorovnat, než cokoli postavíte.</li>
            <li><span class="text-ink">→</span> Pozvánku na bezplatnou 45min konzultaci. Bez tlaku.</li>
          </ul>
        </div>

        <div class="rounded border border-border bg-bg-warm/40 p-xl">
          <p class="text-label uppercase tracking-wider text-amber">Vaše údaje</p>
          <p class="mt-md text-body text-ink-muted">
            Odpovědi používáme pouze k vyhodnocení — neukládáme do CRM, neprodáváme,
            nezasíláme spam. Po vyhodnocení zůstane jen váš e-mail v případě, že
            si vyžádáte další pokračování. Detaily v
            <a href="/soukromi" class="text-amber underline underline-offset-2">zásadách ochrany soukromí</a>.
          </p>
        </div>

        <div class="rounded border border-border bg-bg-warm/40 p-xl">
          <p class="text-label uppercase tracking-wider text-amber">Kdo to vyhodnocuje</p>
          <p class="mt-md text-body text-ink-muted">
            Vyhodnocení čte <span class="text-ink">Martin Večeřa</span>, vedoucí
            konzultant. Žádný funnel, žádná SDR. Odpověď přijde od stejného
            člověka, který by s vámi vedl Discovery.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline define:vars={{ recaptchaSiteKey, apiBaseUrl }}>
    (function () {
      const form = document.getElementById('readiness-form');
      if (!form) return;

      const steps = Array.from(form.querySelectorAll('fieldset[data-step]'));
      const indicators = Array.from(document.querySelectorAll('[data-step-indicator]'));
      const progressLabel = document.getElementById('progress-label');
      const progressStepName = document.getElementById('progress-step-name');
      const progressBar = document.getElementById('progress-bar');
      const btnPrev = document.getElementById('btn-prev');
      const btnNext = document.getElementById('btn-next');
      const btnSubmit = document.getElementById('btn-submit');
      const successState = document.getElementById('success-state');
      const errorBox = document.getElementById('readiness-error');
      const stepNames = ['O firmě', 'Datová připravenost', 'Lidé a procesy', 'Cíle', 'Kontakt'];
      const total = steps.length;
      let current = 1;

      // reCAPTCHA v3 — lazy load na první focus do formuláře (plan §4.1).
      let recaptchaLoading = false;
      function loadRecaptcha() {
        if (recaptchaLoading || window.grecaptcha) return;
        if (!recaptchaSiteKey) return;
        recaptchaLoading = true;
        const s = document.createElement('script');
        s.src = 'https://www.google.com/recaptcha/api.js?render=' + encodeURIComponent(recaptchaSiteKey);
        s.async = true;
        s.defer = true;
        document.head.appendChild(s);
      }
      form.addEventListener('focusin', loadRecaptcha, { once: true });

      function getRecaptchaToken(action) {
        return new Promise((resolve, reject) => {
          if (!recaptchaSiteKey) {
            reject(new Error('Missing reCAPTCHA site key'));
            return;
          }
          loadRecaptcha();
          const start = Date.now();
          (function waitForGrecaptcha() {
            if (window.grecaptcha && window.grecaptcha.execute) {
              window.grecaptcha.ready(() => {
                window.grecaptcha
                  .execute(recaptchaSiteKey, { action })
                  .then(resolve)
                  .catch(reject);
              });
              return;
            }
            if (Date.now() - start > 8000) {
              reject(new Error('reCAPTCHA load timeout'));
              return;
            }
            setTimeout(waitForGrecaptcha, 100);
          })();
        });
      }

      function showError(msg) {
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
      }

      function clearError() {
        errorBox.textContent = '';
        errorBox.classList.add('hidden');
      }

      function render() {
        steps.forEach((s) => {
          const n = Number(s.dataset.step);
          s.classList.toggle('hidden', n !== current);
        });
        indicators.forEach((el) => {
          const n = Number(el.dataset.stepIndicator);
          el.classList.toggle('bg-amber', n <= current);
          el.classList.toggle('bg-border', n > current);
        });
        progressLabel.textContent = 'Krok ' + current + ' z ' + total;
        progressStepName.textContent = stepNames[current - 1];
        progressBar.setAttribute('aria-valuenow', String(current));
        btnPrev.disabled = current === 1;
        const isLast = current === total;
        btnNext.classList.toggle('hidden', isLast);
        btnSubmit.classList.toggle('hidden', !isLast);
      }

      function validateCurrent() {
        const fieldset = steps.find((s) => Number(s.dataset.step) === current);
        if (!fieldset) return true;
        const required = fieldset.querySelectorAll('[required]');
        for (const field of required) {
          if (field.type === 'radio') {
            const group = fieldset.querySelectorAll('input[name="' + field.name + '"]');
            if (!Array.from(group).some((g) => g.checked)) {
              alert('Vyberte prosím odpověď u: ' + (field.closest('div')?.querySelector('p')?.textContent ?? field.name));
              return false;
            }
          } else if (!field.checkValidity()) {
            field.reportValidity();
            return false;
          }
        }
        return true;
      }

      btnNext.addEventListener('click', () => {
        if (!validateCurrent()) return;
        if (current < total) {
          current += 1;
          render();
          window.scrollTo({ top: form.offsetTop - 100, behavior: 'smooth' });
        }
      });

      btnPrev.addEventListener('click', () => {
        if (current > 1) {
          current -= 1;
          render();
          window.scrollTo({ top: form.offsetTop - 100, behavior: 'smooth' });
        }
      });

      // Sběr odpovědí ze step 1–4 do `odpovedi` objektu.
      // Personal fields (jmeno, firma, email, telefon, gdpr) jdou do top-level payloadu.
      const personalFields = new Set(['jmeno', 'firma', 'email', 'telefon', 'gdpr']);

      function collectOdpovedi(formData) {
        const result = {};
        const seen = new Set();
        form.querySelectorAll('[name]').forEach((el) => {
          const name = el.getAttribute('name');
          if (!name || personalFields.has(name) || seen.has(name)) return;
          seen.add(name);
          const all = formData.getAll(name);
          const filtered = all
            .map((v) => (typeof v === 'string' ? v.trim() : v))
            .filter((v) => v !== '' && v !== undefined && v !== null);
          if (filtered.length === 0) return;
          result[name] = filtered.length === 1 ? filtered[0] : filtered;
        });
        return result;
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearError();

        if (!validateCurrent()) return;

        btnSubmit.disabled = true;
        const originalLabel = btnSubmit.textContent;
        btnSubmit.textContent = 'Odesílám…';

        try {
          const token = await getRecaptchaToken('ai_readiness');
          const formData = new FormData(form);
          const telefon = (formData.get('telefon') || '').toString().trim();
          const payload = {
            jmeno: (formData.get('jmeno') || '').toString().trim(),
            firma: (formData.get('firma') || '').toString().trim(),
            email: (formData.get('email') || '').toString().trim(),
            odpovedi: collectOdpovedi(formData),
            gdprConsent: formData.get('gdpr') !== null,
            recaptchaToken: token,
          };
          if (telefon) payload.telefon = telefon;

          const ctrl = new AbortController();
          const timeoutId = setTimeout(() => ctrl.abort(), 20000);
          let r;
          try {
            r = await fetch(apiBaseUrl + '/api/ai-readiness', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              signal: ctrl.signal,
            });
          } finally {
            clearTimeout(timeoutId);
          }

          let json = null;
          try {
            json = await r.json();
          } catch (_) {
            // tělo nemusí být JSON
          }

          if (!r.ok || !json || !json.ok) {
            const msg =
              (json && typeof json.error === 'string' ? json.error : null) ||
              ('HTTP ' + r.status);
            throw new Error(msg);
          }

          const s = json.score;
          if (s) {
            document.getElementById('score-total').textContent = String(s.total);
            document.getElementById('success-email').textContent = payload.email;

            const summaryText = s.total >= 70
              ? 'Vaše firma je v pásmu PŘIPRAVENÁ — máte všechno potřebné pro pilotní AI projekt v horizontu 3–6 měsíců.'
              : s.total >= 40
              ? 'Vaše firma je v pásmu KANDIDÁT — máte solidní základ, ale je potřeba dorovnat pár věcí před prvním pilotem.'
              : 'Vaše firma je v pásmu PRŮZKUM — má smysl začít datovým auditem před jakýmkoli AI projektem.';
            document.getElementById('score-summary').textContent = summaryText;

            const noteFor = (dim, val) => {
              const band = val >= 70 ? 'pripravena' : val >= 40 ? 'kandidat' : 'pruzkum';
              const notes = {
                data: { pripravena: 'Máte solidní datový základ — typicky stačí lehký audit a pak se dá stavět.', kandidat: 'Datová základna je smíšená — 30–60 dní práce na sjednocení 2–3 datasetů zlepší šanci na úspěch.', pruzkum: 'Data v současném stavu nejsou pro AI připravená — doporučujeme začít datovým auditem před cokoliv jiným.' },
                lide: { pripravena: 'Tým má vlastníka projektu i kapacitu — můžete startovat.', kandidat: 'Lidská strana je zvládnutelná, ale doporučujeme vyřešit kapacitu nebo vlastnictví projektu před prvním pilotem.', pruzkum: 'Bez jasného vlastníka a tým podpory AI projekt nepřežije fázi nadšení — řešte tohle nejdřív.' },
                strategie: { pripravena: 'Cíl, horizont i rozpočet jsou v rozumné rovnováze — můžeme přejít k plánu.', kandidat: 'Cíl je rámcově jasný, ale horizont nebo rozpočet potřebují upřesnit, aby plán šel naplánovat.', pruzkum: 'Bez jasného cíle a horizontu nemá smysl AI plánovat — doporučujeme úvodní workshop o tom, co konkrétně řešíte.' },
                provoz: { pripravena: 'Provozní zázemí (ERP, velikost, obor) je standardní — bez překvapení.', kandidat: 'Provoz má drobné slabiny (např. menší ERP nebo netypická velikost), které ale nejsou blokátorem.', pruzkum: 'Provozní zázemí výrazně limituje AI projekt — typicky chybí ERP nebo je firma mimo náš sweet-spot.' },
              };
              return notes[dim][band];
            };

            ['data', 'lide', 'strategie', 'provoz'].forEach((dim) => {
              const val = s.dimensions[dim];
              document.querySelector('[data-dim-score="' + dim + '"]').textContent = String(val);
              document.querySelector('[data-dim-note="' + dim + '"]').textContent = noteFor(dim, val);
              requestAnimationFrame(() => {
                document.querySelector('[data-dim-bar="' + dim + '"]').style.width = val + '%';
              });
            });
          }

          form.classList.add('hidden');
          document.getElementById('progress-wrapper').classList.add('hidden');
          successState.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (err) {
          console.error('[ai-readiness] submit failed:', err);
          showError(
            'Odeslání se nepovedlo. Zkuste to prosím znovu nebo nám napište přímo na hello@quconsult.cz.',
          );
          btnSubmit.disabled = false;
          btnSubmit.textContent = originalLabel;
        }
      });

      render();
    })();
  </script>
</BaseLayout>
