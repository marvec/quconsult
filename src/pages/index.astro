---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="QuConsult — Praktické AI pro české firmy"
  description="Pomáháme českým firmám automatizovat procesy, integrovat AI do aplikací a budovat chytřejší byznys — s měřitelnými výsledky v korunách."
>
  <section class="container-quc py-xxl">
    <p class="text-label uppercase tracking-wider text-amber">QuConsult</p>

    <h1 class="mt-md font-serif text-h1-mobile leading-[1.1] tracking-tight md:text-h1-desktop">
      Proměňte AI z buzzwordu ve váš největší konkurenční nástroj
    </h1>

    <p class="mt-lg max-w-2xl text-body-lg text-ink-muted">
      Pomáháme českým firmám automatizovat procesy, integrovat AI do aplikací
      a budovat chytřejší byznys — s měřitelnými výsledky v korunách.
    </p>

    <div class="mt-xl flex flex-wrap gap-md">
      <a
        href="/kontakt"
        class="inline-flex items-center rounded bg-amber px-lg py-md text-label font-medium text-bg transition-colors hover:bg-amber-deep"
      >
        Domluvit bezplatnou konzultaci
      </a>
      <a
        href="#agentic-os"
        class="inline-flex items-center rounded border border-ink px-lg py-md text-label font-medium text-ink transition-colors hover:border-amber hover:text-amber"
      >
        Podívat se, jak řídíme vlastní firmu
      </a>
    </div>

    <p class="mt-xxl border-t border-border pt-lg text-label text-ink-soft">
      Web ve výstavbě. Aktuální stará verze:
      <a href="https://quconsult.cz" class="underline hover:text-amber">quconsult.cz</a>.
    </p>
  </section>
</BaseLayout>
