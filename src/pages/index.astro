---
// Homepage — Phase 3 §3.1.
// Sources: plan.md §3.1, decisions.md §1 (Stitch winner 7fef5f99 + fix list).
// Konzumuje content collection 'sluzby' — žádná hardcoded jména/ceny.
// Tým preview vynechán per Stitch fix #1 (žije jen na /o-nas).
// Blog teaser vynechán dokud není první reálný článek (CLAUDE.md §3 no placeholder).

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ValueProp from '../components/ValueProp.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTASection from '../components/CTASection.astro';

const services = (await getCollection('sluzby')).sort(
  (a, b) => a.data.order - b.data.order,
);

const valueProps = [
  {
    number: '01',
    title: 'Inside-out, ne outside-in',
    body: 'Nepřinášíme univerzální šablonu. Začínáme tím, co u vás reálně bolí, a hledáme nejmenší smysluplný krok.',
  },
  {
    number: '02',
    title: 'Žádný vendor lock-in',
    body: 'Předáváme zdrojové kódy, dokumentaci a know-how. Cílem je, aby nás váš tým za 6–12 měsíců nepotřeboval.',
  },
  {
    number: '03',
    title: 'Používáme to, co prodáváme',
    body: 'Vlastní firmu řídíme s Agentic OS — tím samým přístupem, který doporučujeme klientům. Demo je veřejné.',
  },
];
---
<BaseLayout
  title="QuConsult — AI konzultace pro české firmy"
  description="Pomáháme českým firmám automatizovat procesy, integrovat AI do aplikací a budovat chytřejší byznys — s měřitelnými výsledky v korunách."
>
  <Hero
    eyebrow="QuConsult"
    subtitle="Pomáháme českým firmám automatizovat procesy, integrovat AI do aplikací a budovat chytřejší byznys — s měřitelnými výsledky v korunách."
    primaryCta={{ label: 'Domluvit bezplatnou konzultaci', href: '/kontakt' }}
    secondaryCta={{ label: 'Podívat se, jak řídíme vlastní firmu', href: '#agentic-os' }}
  >
    Proměňte AI z buzzwordu ve váš největší <span class="italic text-amber">konkurenční nástroj</span>
  </Hero>

  <section class="container-quc py-xxl">
    <p class="text-label uppercase tracking-wider text-amber">Proč právě my</p>
    <h2 class="mt-sm max-w-2xl font-serif text-3xl text-ink md:text-h2-desktop">
      Praktické AI bez velkých transformací a vendor lock-inu
    </h2>
    <div class="mt-xl grid gap-xl md:grid-cols-3">
      {valueProps.map((v) => <ValueProp number={v.number} title={v.title} body={v.body} />)}
    </div>
  </section>

  <section class="bg-bg-warm">
    <div class="container-quc py-xxl">
      <p class="text-label uppercase tracking-wider text-amber">Co pro vás děláme</p>
      <h2 class="mt-sm max-w-2xl font-serif text-3xl text-ink md:text-h2-desktop">
        Čtyři způsoby, jak vám pomůžeme
      </h2>
      <div class="mt-xl grid gap-md md:grid-cols-2">
        {services.map((s, i) => (
          <ServiceCard
            number={i + 1}
            title={s.data.title}
            blurb={s.data.summary}
            href={`/sluzby/${s.id}`}
            forWho={s.data.forWho}
            outcome={s.data.typicalOutcome}
            priceFrom={s.data.priceFrom}
            tags={s.data.tags}
            variant="full"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="container-quc py-xxl">
    <p class="text-label uppercase tracking-wider text-amber">Stav v ČR</p>
    <h2 class="mt-sm max-w-3xl font-serif text-3xl text-ink md:text-h2-desktop">
      48&nbsp;% českých firem už AI používá. 56&nbsp;% má jako blokátor data.
    </h2>
    <p class="mt-md max-w-3xl text-body-lg text-ink-muted">
      Pomáháme s obojím. Mapujeme datovou připravenost, doplňujeme co chybí,
      a teprve potom stavíme. Pilotní projekty mají měřitelný výsledek do měsíce
      po nasazení — ne do roka po prezentaci.
    </p>
    <div class="mt-xl grid gap-xl border-t border-border pt-xl md:grid-cols-3">
      <div>
        <p class="font-serif text-4xl text-ink md:text-5xl">48&nbsp;%</p>
        <p class="mt-sm text-body text-ink-muted">
          Českých firem už nějakou formu AI používá.
        </p>
      </div>
      <div>
        <p class="font-serif text-4xl text-ink md:text-5xl">56&nbsp;%</p>
        <p class="mt-sm text-body text-ink-muted">
          Hlásí kvalitu dat jako primární blokátor pro nasazení.
        </p>
      </div>
      <div>
        <p class="font-serif text-4xl text-ink md:text-5xl">2 týdny</p>
        <p class="mt-sm text-body text-ink-muted">
          Discovery s pevnou cenou. Žádný balíček neomezené konzultace.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-bg-warm">
    <div class="container-quc py-xxl">
      <p class="text-label uppercase tracking-wider text-amber">Pro koho jsme</p>
      <h2 class="mt-sm max-w-3xl font-serif text-3xl text-ink md:text-h2-desktop">
        Dvě skupiny firem, kterým rozumíme
      </h2>
      <div class="mt-xl grid gap-xl md:grid-cols-2">
        <article class="rounded border border-border bg-bg p-xl">
          <p class="text-label uppercase tracking-wider text-ink-soft">Výroba</p>
          <h3 class="mt-sm font-serif text-2xl text-ink md:text-3xl">
            Středně velké výrobní firmy
          </h3>
          <p class="mt-md text-body text-ink-muted">
            50 až 300 zaměstnanců, ERP nasazený 5 až 15 let, manuální procesy
            v Pohodě, Heliosu nebo SAP B1. Typicky CEO nebo COO, který vidí,
            kolik práce stojí administrativa, a hledá konkrétní úsporu.
          </p>
        </article>
        <article class="rounded border border-border bg-bg p-xl">
          <p class="text-label uppercase tracking-wider text-ink-soft">Profesionální služby</p>
          <h3 class="mt-sm font-serif text-2xl text-ink md:text-3xl">
            Odborné kanceláře 5 až 30 lidí
          </h3>
          <p class="mt-md text-body text-ink-muted">
            Advokátní kanceláře, daňoví poradci, projekční firmy, marketingové
            agentury. Často partneři, kteří chtějí ušetřit hodiny seniorních
            specialistů na rutinní práci a uvolnit kapacitu na zákazníky.
          </p>
        </article>
      </div>
      <p class="mt-xl text-label text-ink-muted">
        Pro koho jsme méně vhodní: korporáty s vlastním AI týmem, firmy pod
        30 lidí bez vlastního IT, vendoři hledající white-label produkt.
      </p>
    </div>
  </section>

  <section id="agentic-os" class="container-quc py-xxl">
    <p class="text-label uppercase tracking-wider text-amber">Důkaz, ne marketing</p>
    <h2 class="mt-sm max-w-3xl font-serif text-3xl text-ink md:text-h2-desktop">
      Jak řídíme vlastní firmu
    </h2>
    <div class="mt-xl grid gap-xl md:grid-cols-[1fr_1fr]">
      <div>
        <p class="text-body-lg text-ink-muted">
          Agentic OS je interní systém AI agentů, kterým operujeme QuConsult —
          úkoly, content workflow, klientská komunikace, research. Není to
          SaaS, který si koupíte. Je to ukázka toho, jak přemýšlíme
          o implementaci, a důkaz, že naše doporučení používáme i sami na sebe.
        </p>
        <p class="mt-md text-body text-ink-muted">
          Na YouTube zveřejňujeme epizody o tom, jak konkrétní část systému
          řešíme. Co se osvědčilo, co jsme vyhodili, kde nás něco zaskočilo.
          Pro vás je to nejrychlejší způsob, jak posoudit, jestli s námi
          chcete mluvit.
        </p>
        <div class="mt-xl flex flex-wrap gap-md">
          <a
            href="https://www.youtube.com/@quconsult"
            rel="noopener"
            class="inline-flex items-center rounded bg-amber px-lg py-md text-label font-medium text-bg transition-colors hover:bg-amber-deep"
          >
            Podívat se na YouTube
          </a>
          <a
            href="/sluzby/implementace-a-vyvoj"
            class="inline-flex items-center rounded border border-ink px-lg py-md text-label font-medium text-ink transition-colors hover:border-amber hover:text-amber"
          >
            Jak ho stavíme klientům
          </a>
        </div>
      </div>
      <aside class="rounded border border-border bg-bg-warm/40 p-xl">
        <p class="text-label uppercase tracking-wider text-ink-soft">Co Agentic OS dělá</p>
        <ul class="mt-md space-y-md text-body text-ink-muted">
          <li>— Plánuje a sleduje úkoly napříč projekty.</li>
          <li>— Generuje weekly report z aktivity bez ručního agregování.</li>
          <li>— Připravuje podklady pro klientské schůzky a research.</li>
          <li>— Vede content workflow — od nápadu po publikaci.</li>
          <li>— Sleduje technický health vlastní infrastruktury.</li>
        </ul>
        <p class="mt-lg text-label text-ink-soft">
          Stejnou architekturu stavíme klientům — vždy na míru, vždy
          s předáním, nikdy jako licenci.
        </p>
      </aside>
    </div>
  </section>

  <CTASection
    title="Domluvte si 45minutovou bezplatnou konzultaci"
    subtitle="Identifikujeme TOP 3 příležitosti pro AI ve vaší firmě — bez závazku, bez prodejního tlaku."
    primaryCta={{ label: 'Domluvit konzultaci', href: '/kontakt' }}
    variant="amber"
    withEmailField={true}
  />
</BaseLayout>
