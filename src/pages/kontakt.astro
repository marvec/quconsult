---
// /kontakt — Phase 4 §3.12.
// Stitch winner ace45cef (decisions.md §9).
//
// Form posílá JSON na ${PUBLIC_API_BASE_URL}/api/contact (Vercel funkce
// se schématem v zod-u, reCAPTCHA v3 verifikací a SMTP odesláním přes
// nodemailer). Bez JS form spadne na mailto: action — graceful degradation
// per CLAUDE.md §4.

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL;
---
<BaseLayout
  title="Kontakt — QuConsult"
  description="Domluvte si bezplatnou 45minutovou konzultaci. Identifikujeme TOP 3 příležitosti pro AI ve vaší firmě — bez závazku, bez prodejního tlaku."
>
  <Hero
    eyebrow="Kontakt"
    subtitle="Identifikujeme TOP 3 příležitosti pro AI ve vaší firmě — bez závazku, bez prodejního tlaku, bez prezentace s 80 slidy."
  >
    Domluvme si <span class="italic text-amber">45minutovou</span> bezplatnou konzultaci
  </Hero>

  <section class="container-quc pb-xxl">
    <div class="grid gap-xl lg:grid-cols-[2fr_1fr]">
      <div>
        <form
          id="contact-form"
          method="post"
          action="mailto:hello@quconsult.cz"
          enctype="text/plain"
          class="space-y-xl"
          novalidate
        >
          <div class="grid gap-xl md:grid-cols-2">
            <div>
              <label for="name" class="block text-label uppercase tracking-wider text-ink-soft">
                Jméno a příjmení *
              </label>
              <input
                id="name"
                name="jmeno"
                type="text"
                required
                minlength="2"
                autocomplete="name"
                class="mt-sm w-full border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink placeholder:text-ink-soft focus:border-amber focus:outline-none focus:ring-0"
              />
            </div>
            <div>
              <label for="company" class="block text-label uppercase tracking-wider text-ink-soft">
                Firma *
              </label>
              <input
                id="company"
                name="firma"
                type="text"
                required
                autocomplete="organization"
                class="mt-sm w-full border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink placeholder:text-ink-soft focus:border-amber focus:outline-none focus:ring-0"
              />
            </div>
            <div>
              <label for="position" class="block text-label uppercase tracking-wider text-ink-soft">
                Pozice *
              </label>
              <input
                id="position"
                name="pozice"
                type="text"
                required
                autocomplete="organization-title"
                class="mt-sm w-full border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink placeholder:text-ink-soft focus:border-amber focus:outline-none focus:ring-0"
              />
            </div>
            <div>
              <label for="email" class="block text-label uppercase tracking-wider text-ink-soft">
                E-mail *
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="mt-sm w-full border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink placeholder:text-ink-soft focus:border-amber focus:outline-none focus:ring-0"
              />
            </div>
            <div class="md:col-span-2">
              <label for="phone" class="block text-label uppercase tracking-wider text-ink-soft">
                Telefon (volitelný)
              </label>
              <input
                id="phone"
                name="telefon"
                type="tel"
                autocomplete="tel"
                class="mt-sm w-full border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink placeholder:text-ink-soft focus:border-amber focus:outline-none focus:ring-0"
              />
            </div>
          </div>

          <div>
            <label for="message" class="block text-label uppercase tracking-wider text-ink-soft">
              Co řešíte? *
            </label>
            <textarea
              id="message"
              name="zprava"
              rows="5"
              required
              minlength="10"
              placeholder="Stručně popište, co vás trápí nebo s čím byste rádi pomohli."
              class="mt-sm w-full resize-none border-0 border-b border-border bg-transparent px-0 py-md text-body text-ink placeholder:text-ink-soft focus:border-amber focus:outline-none focus:ring-0"
            ></textarea>
          </div>

          <div class="flex items-start gap-md">
            <input
              id="gdpr"
              name="gdpr"
              type="checkbox"
              required
              value="souhlasím"
              class="mt-1 h-4 w-4 cursor-pointer accent-amber"
            />
            <label for="gdpr" class="cursor-pointer text-label text-ink-muted">
              Souhlasím se zpracováním osobních údajů dle
              <a href="/soukromi" class="text-amber underline underline-offset-2">zásad ochrany soukromí</a>.
            </label>
          </div>

          <div
            id="contact-error"
            class="hidden rounded border border-red-300 bg-red-50 p-md text-label text-red-700"
            role="alert"
          ></div>

          <button
            id="contact-submit"
            type="submit"
            class="inline-flex w-full items-center justify-center rounded bg-amber px-xl py-md text-label font-medium uppercase tracking-wider text-bg transition-colors hover:bg-amber-deep disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
          >
            Odeslat a domluvit konzultaci
          </button>

          <p class="text-label text-ink-soft">
            Odpovídáme do 24 hodin v pracovních dnech. Konzultace probíhá online
            (Google Meet) nebo osobně v Brně. Formulář je chráněn proti spamu
            přes Google reCAPTCHA — odesláním souhlasíte s
            <a href="https://policies.google.com/privacy" rel="noopener" class="text-amber underline underline-offset-2">privacy policy</a>
            a
            <a href="https://policies.google.com/terms" rel="noopener" class="text-amber underline underline-offset-2">terms of service</a>
            Googlu.
          </p>
        </form>

        <!-- Success state (skrytý do submitu) -->
        <div id="contact-success" class="hidden mt-xl rounded border border-amber bg-amber/5 p-xl">
          <p class="text-label uppercase tracking-wider text-amber">Hotovo</p>
          <h2 class="mt-sm font-serif text-2xl text-ink md:text-3xl">
            Děkujeme. Ozveme se do 24 hodin v pracovních dnech.
          </h2>
          <p class="mt-md text-body text-ink-muted">
            Zpráva dorazila. Mezitím se můžete podívat na
            <a href="/jak-pracujeme" class="text-amber underline underline-offset-2">jak pracujeme</a>
            nebo si přečíst
            <a href="/blog" class="text-amber underline underline-offset-2">poslední články</a>.
          </p>
        </div>
      </div>

      <aside class="space-y-xl">
        <div class="rounded border border-border bg-bg-warm/40 p-xl">
          <p class="text-label uppercase tracking-wider text-amber">Kontakt napřímo</p>
          <ul class="mt-md space-y-md text-body text-ink-muted">
            <li>
              <a href="mailto:hello@quconsult.cz" class="text-ink hover:text-amber">
                hello@quconsult.cz
              </a>
            </li>
            <li>
              <a href="tel:+420777000000" class="text-ink hover:text-amber">
                +420 777 000 000
              </a>
            </li>
            <li>
              <a href="https://linkedin.com/company/quconsult" rel="noopener" class="text-ink hover:text-amber">
                LinkedIn
              </a>
            </li>
          </ul>
        </div>

        <div class="rounded border border-border bg-bg-warm/40 p-xl">
          <p class="text-label uppercase tracking-wider text-amber">Kde nás najdete</p>
          <address class="mt-md not-italic text-body text-ink-muted leading-relaxed">
            <span class="text-ink">WellBe s.r.o.</span><br />
            Nové sady 988/2<br />
            602 00 Brno
          </address>
          <p class="mt-md text-label text-ink-soft">
            IČ 05830931 · DIČ CZ05830931
          </p>
        </div>

        <div class="rounded border border-border bg-bg-warm/40 p-xl">
          <p class="text-label uppercase tracking-wider text-amber">Co se stane potom</p>
          <ol class="mt-md space-y-md text-body text-ink-muted">
            <li><span class="text-ink">1.</span> Do 24 hodin se ozveme s návrhem termínu.</li>
            <li><span class="text-ink">2.</span> 45 minut online — posloucháme, ptáme se, neprezentujeme.</li>
            <li><span class="text-ink">3.</span> Krátký souhrn s konkrétními návrhy. Bez závazku.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline define:vars={{ recaptchaSiteKey, apiBaseUrl }}>
    (function () {
      const form = document.getElementById('contact-form');
      if (!form) return;

      // Prefill e-mailu z ?email= query (homepage CTA → /kontakt?email=...)
      const params = new URLSearchParams(window.location.search);
      const emailQuery = params.get('email');
      const emailField = document.getElementById('email');
      if (emailQuery && emailField) emailField.value = emailQuery;

      const submitBtn = document.getElementById('contact-submit');
      const errorBox = document.getElementById('contact-error');
      const successBox = document.getElementById('contact-success');

      // reCAPTCHA v3 — lazy load na první focus do formuláře (plan §4.1).
      let recaptchaLoading = false;
      function loadRecaptcha() {
        if (recaptchaLoading || window.grecaptcha) return;
        if (!recaptchaSiteKey) return;
        recaptchaLoading = true;
        const s = document.createElement('script');
        s.src = 'https://www.google.com/recaptcha/api.js?render=' + encodeURIComponent(recaptchaSiteKey);
        s.async = true;
        s.defer = true;
        document.head.appendChild(s);
      }
      form.addEventListener('focusin', loadRecaptcha, { once: true });

      function getRecaptchaToken(action) {
        return new Promise((resolve, reject) => {
          if (!recaptchaSiteKey) {
            reject(new Error('Missing reCAPTCHA site key'));
            return;
          }
          loadRecaptcha();
          const start = Date.now();
          (function waitForGrecaptcha() {
            if (window.grecaptcha && window.grecaptcha.execute) {
              window.grecaptcha.ready(() => {
                window.grecaptcha
                  .execute(recaptchaSiteKey, { action })
                  .then(resolve)
                  .catch(reject);
              });
              return;
            }
            if (Date.now() - start > 8000) {
              reject(new Error('reCAPTCHA load timeout'));
              return;
            }
            setTimeout(waitForGrecaptcha, 100);
          })();
        });
      }

      function showError(msg) {
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
      }

      function clearError() {
        errorBox.textContent = '';
        errorBox.classList.add('hidden');
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearError();

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        submitBtn.disabled = true;
        const originalLabel = submitBtn.textContent;
        submitBtn.textContent = 'Odesílám…';

        try {
          const token = await getRecaptchaToken('contact_form');
          const formData = new FormData(form);
          const telefon = (formData.get('telefon') || '').toString().trim();
          const payload = {
            jmeno: (formData.get('jmeno') || '').toString().trim(),
            firma: (formData.get('firma') || '').toString().trim(),
            pozice: (formData.get('pozice') || '').toString().trim(),
            email: (formData.get('email') || '').toString().trim(),
            zprava: (formData.get('zprava') || '').toString().trim(),
            gdprConsent: formData.get('gdpr') !== null,
            recaptchaToken: token,
          };
          if (telefon) payload.telefon = telefon;

          const ctrl = new AbortController();
          const timeoutId = setTimeout(() => ctrl.abort(), 20000);
          let r;
          try {
            r = await fetch(apiBaseUrl + '/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              signal: ctrl.signal,
            });
          } finally {
            clearTimeout(timeoutId);
          }

          let json = null;
          try {
            json = await r.json();
          } catch (_) {
            // tělo nemusí být JSON
          }

          if (!r.ok || !json || !json.ok) {
            const msg =
              (json && typeof json.error === 'string' ? json.error : null) ||
              ('HTTP ' + r.status);
            const detail = json && typeof json.detail === 'string' ? ' — ' + json.detail : '';
            throw new Error(msg + detail);
          }

          form.classList.add('hidden');
          successBox.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (err) {
          console.error('[contact] submit failed:', err);
          showError(
            'Odeslání se nepovedlo. Zkuste to prosím znovu nebo nám napište přímo na hello@quconsult.cz.',
          );
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      });
    })();
  </script>
</BaseLayout>
