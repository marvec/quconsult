---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileNavDrawer from '../components/MobileNavDrawer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Praktické AI poradenství pro české firmy. Bez hype, bez buzzwordů.',
  ogImage = '/og-default.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();

// Schema.org Organization — WellBe s.r.o. is the legal entity behind QuConsult brand
// (CLAUDE.md §1, plan.md §0). IČ + sídlo per plan; sameAs links populated as channels go live.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'QuConsult',
  legalName: 'WellBe s.r.o.',
  url: 'https://quconsult.cz',
  logo: 'https://quconsult.cz/favicon.svg',
  image: ogImageUrl,
  description: 'Praktické AI poradenství pro české firmy.',
  taxID: 'CZ05830931',
  vatID: 'CZ05830931',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Nové sady 988/2',
    postalCode: '602 00',
    addressLocality: 'Brno',
    addressCountry: 'CZ',
  },
  sameAs: [
    'https://www.linkedin.com/company/quconsult-cz/',
    'https://www.youtube.com/@quconsult',
    'https://github.com/marvec',
  ],
};
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FAFAF8" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="QuConsult" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- RSS feed discovery -->
    <link rel="alternate" type="application/rss+xml" title="QuConsult — blog" href="/rss.xml" />

    <!-- Fonts (Google Fonts CDN — runtime; build-time PNG generation uses TTFs in scripts/fonts/) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org Organization (CLAUDE.md §4 always rule) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- View transitions (Astro built-in, no JS lib — plan §4.7) -->
    <ClientRouter />

    <!-- Google Consent Mode v2 default — denied před gtag.js -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      gtag('set', 'ads_data_redaction', true);
    </script>

    <!-- Cookie consent + GA4 init -->
    <script>
      import 'vanilla-cookieconsent/dist/cookieconsent.css';
      import '../styles/cookie-consent.css';
      import { CookieConsent, ccConfig } from '../lib/cookie-consent';

      const init = () => {
        if (window.__ccInitialized) return;
        window.__ccInitialized = true;
        CookieConsent.run(ccConfig);
      };

      document.addEventListener('astro:page-load', init, { once: true });
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileNavDrawer />
  </body>
</html>
