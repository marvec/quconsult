---
// MobileNavDrawer.astro — full-page slide-in nav drawer for < md viewport.
// No Stitch reference (Stitch is desktop-only); built from DESIGN_BRIEF rules:
// plain bg-bg, amber for accent (not background), no gradient, no shadow under lg.
//
// Behavior: hamburger button toggles drawer; ESC closes; click on backdrop closes;
// scroll lock on <html>; focus trap inside drawer while open.

const navItems = [
  { label: 'Domů', href: '/' },
  { label: 'Jak pracujeme', href: '/jak-pracujeme' },
  { label: 'Blog', href: '/blog' },
  { label: 'O nás', href: '/o-nas' },
  { label: 'Kontakt', href: '/kontakt' },
];

const services = [
  { label: 'AI Analýza a strategie', href: '/sluzby/analyza-a-strategie' },
  { label: 'Automatizace procesů', href: '/sluzby/automatizace-procesu' },
  { label: '(Nejen) AI školení', href: '/sluzby/skoleni' },
  { label: 'AI Implementace a vývoj', href: '/sluzby/implementace-a-vyvoj' },
];
---
<button
  type="button"
  class="mobile-nav-trigger inline-flex h-10 w-10 items-center justify-center rounded text-ink-muted transition-colors hover:text-ink md:hidden"
  aria-label="Otevřít menu"
  aria-expanded="false"
  aria-controls="mobile-nav-drawer"
>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <line x1="3" y1="6" x2="21" y2="6" />
    <line x1="3" y1="12" x2="21" y2="12" />
    <line x1="3" y1="18" x2="21" y2="18" />
  </svg>
</button>

<div
  id="mobile-nav-drawer"
  class="mobile-drawer invisible fixed inset-0 z-50 opacity-0 transition-[opacity,visibility] duration-base md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Hlavní navigace"
  aria-hidden="true"
>
  <div class="mobile-drawer-backdrop absolute inset-0 bg-ink/40" data-close></div>

  <div class="mobile-drawer-panel absolute inset-y-0 right-0 flex w-full max-w-sm translate-x-full flex-col bg-bg transition-transform duration-base">
    <div class="flex h-16 items-center justify-between border-b border-border px-lg">
      <span class="font-serif text-lg font-semibold tracking-tight">QuConsult</span>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded text-ink-muted transition-colors hover:text-ink"
        aria-label="Zavřít menu"
        data-close
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="6" y1="18" x2="18" y2="6" />
        </svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto p-lg" aria-label="Mobilní navigace">
      <ul class="space-y-md">
        <li>
          <a href="/" class="block py-sm font-serif text-2xl text-ink hover:text-amber">Domů</a>
        </li>

        <li>
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between py-sm font-serif text-2xl text-ink marker:hidden">
              Služby
              <span class="text-label text-ink-soft transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <ul class="mt-sm space-y-sm border-l border-border pl-md">
              {services.map((s) => (
                <li>
                  <a href={s.href} class="block py-xs text-body text-ink-muted hover:text-amber">{s.label}</a>
                </li>
              ))}
              <li class="pt-xs">
                <a href="/sluzby" class="inline-flex items-center gap-xs text-label font-medium text-amber hover:text-amber-deep">
                  Všechny služby <span aria-hidden="true">→</span>
                </a>
              </li>
            </ul>
          </details>
        </li>

        {navItems.slice(1).map((item) => (
          <li>
            <a href={item.href} class="block py-sm font-serif text-2xl text-ink hover:text-amber">
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href="/kontakt"
        class="mt-xl flex items-center justify-center rounded bg-amber px-md py-md text-label font-medium text-bg transition-colors hover:bg-amber-deep"
      >
        Domluvit konzultaci
      </a>
    </nav>
  </div>
</div>

<style>
  .mobile-drawer.is-open {
    opacity: 1;
    visibility: visible;
  }
  .mobile-drawer.is-open .mobile-drawer-panel {
    transform: translateX(0);
  }
  /* Hide the default <details> marker across browsers */
  summary::-webkit-details-marker {
    display: none;
  }
  summary::marker {
    content: '';
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-drawer,
    .mobile-drawer-panel {
      transition: none;
    }
  }
</style>

<script>
  const drawer = document.getElementById('mobile-nav-drawer');
  const trigger = document.querySelector<HTMLButtonElement>('.mobile-nav-trigger');
  if (!drawer || !trigger) {
    /* unmounted */
  } else {
    const focusableSelector =
      'a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])';

    const open = () => {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      // Move focus to first focusable inside the panel
      const first = drawer.querySelector<HTMLElement>(focusableSelector);
      first?.focus();
    };

    const close = () => {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      trigger.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      trigger.focus();
    };

    trigger.addEventListener('click', open);

    drawer.querySelectorAll<HTMLElement>('[data-close]').forEach((el) => {
      el.addEventListener('click', close);
    });

    drawer.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== 'Tab') return;

      // Focus trap
      const focusables = Array.from(
        drawer.querySelectorAll<HTMLElement>(focusableSelector),
      ).filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);
      if (focusables.length === 0) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement as HTMLElement | null;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Close on internal nav-link click (so View Transitions don't leave drawer open)
    drawer.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
      a.addEventListener('click', () => {
        // close *after* navigation starts; use rAF so click default is preserved
        requestAnimationFrame(close);
      });
    });
  }
</script>
